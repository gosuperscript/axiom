{
  "$schema": "vendor/infection/infection/resources/schema.json",
  "source": {
    "directories": [
      "src"
    ],
    "excludes": [
      "Testing"
    ]
  },
  "minCoveredMsi": 100,
  "minMsi": 100,
  "mutators": {
    "@default": true,
    "TrueValue": {
      "ignoreSourceCodeByRegex": [
        ".*match\\s*\\(true\\).*",
      ],
    },
    "NullSafeMethodCall": {
      // TypeEnvironment records a read into $reads at the unbound and cycle
      // branches. The cycle branch is reachable only through a definition's
      // own compilation, and TypeInference always hands that compilation a
      // recorder — so $reads is provably non-null there and the strictness
      // mutant ($reads->) is equivalent, unkillable by any test.
      "ignoreSourceCodeByRegex": [
        ".*reads\\?->recordReferences.*",
      ],
    },
  },
  "logs": {
    "text": "build/infection.log",
  }
}